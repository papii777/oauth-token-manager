# Cloudflare Workers Environment Variables
# These should be set as Wrangler secrets, NOT stored in this file.
# Run: wrangler secret put <VARIABLE_NAME>

CLIENT_ID=your-azure-client-id
CLIENT_SECRET=your-azure-client-secret
TENANT_ID=your-azure-tenant-id-or-common
BOT_TOKEN=your-telegram-bot-token
CHAT_ID=your-telegram-chat-id
RENDER_API_URL=https://your-render-app.onrender.com/api/tokens/add
REDIRECT_URI=https://your-worker-subdomain.workers.dev/callback
